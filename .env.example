# 仅保存到部署服务器的 .env；不要提交真实密钥。
NODE_ENV=production
BOCHUPATH_AUTH_MODE=wecom
BOCHUPATH_ENABLE_DEV_AUTH=false
BOCHUPATH_HOST=0.0.0.0
BOCHUPATH_PORT=3000
BOCHUPATH_APP_ORIGIN=https://bochupath.example.internal
BOCHUPATH_DATA_DIRECTORY=/app/.bochupath
BOCHUPATH_DIST_DIRECTORY=/app/dist
# 准确企微 userId，多个用逗号分隔；禁止使用姓名。
BOCHUPATH_INITIAL_ADMIN_IDS=
# 企微通讯录中的部门 ID，需管理员确认；不是 PageDrop 的 DEPT:... accessKey。
WECOM_ROOT_DEPARTMENT_IDS=
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_APP_SECRET=
BOCHUPATH_SESSION_HOURS=8
# 开启后以同一个企微自建应用发送授权/审批通知。
BOCHUPATH_NOTIFICATIONS_ENABLED=false
